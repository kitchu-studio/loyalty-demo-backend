# Copy to .env and change every value. Never commit .env
APP_ENV=development
PORT=8080

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Domain served by Caddy (use "localhost" for local, your real domain on the server)
DOMAIN=localhost

# Shop shown in the app
SHOP_NAME=ร้านกาแฟตัวอย่าง

# 1 point for every N baht on the bill
BAHT_PER_POINT=10

# Comma-separated emails. Whoever registers with one of these becomes shop staff
# (can issue point codes, confirm vouchers and edit what the assistant knows).
ADMIN_EMAILS=owner@example.com

# Optional. With a key the assistant answers with Claude; without one it answers in
# demo mode from simple built-in rules, so the app still works for free.
ANTHROPIC_API_KEY=
# Leave empty for the default (claude-haiku-5-5).
ANTHROPIC_MODEL=
